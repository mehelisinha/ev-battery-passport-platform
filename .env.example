# ───────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# must NEVER be committed. In Azure/Databricks these come from Key Vault instead.
#   cp .env.example .env        (macOS/Linux)
#   Copy-Item .env.example .env (PowerShell)
# ───────────────────────────────────────────────────────────────────────────

# Phase 1 — ENTSO-E Transparency Platform API token
# Request: register at https://newtransparency.entsoe.eu then email
# transparency@entsoe.eu (subject "RESTful API access"). ~3 working days.
ENTSOE_API_TOKEN=

# Phase 2 — Azure Event Hubs (Basic tier connection string)
EVENTHUB_CONNECTION_STRING=
EVENTHUB_NAME=bms-telemetry

# Phase 2 — Redis Cloud (free tier, Redis Stack with TimeSeries module)
REDIS_URL=redis://default:password@host:port

# Phase 3 — Neo4j AuraDB Free
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Phase 4 — Marquez / OpenLineage (local Docker)
OPENLINEAGE_URL=http://localhost:5000
OPENLINEAGE_NAMESPACE=ev-battery-grid
